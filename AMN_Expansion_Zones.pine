//@version=5
indicator("AMN Expansion Zones", "AMN Expansion Zones", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==================================================
// Inputs
// ==================================================
htfTf               = input.timeframe("240", "HTF timeframe")
htfSwingLen         = input.int(3, "HTF swing length", minval=1)
localPivotLen       = input.int(3, "Local pivot length", minval=1)
leftScanBars        = input.int(30, "Left scan bars", minval=3)
internalShiftLookbk = input.int(10, "Internal shift lookback", minval=2)
zoneExtendBars      = input.int(120, "Zone extend bars", minval=10)
fibLevel            = input.float(0.5, "Main fib level", minval=0.0, maxval=1.0, step=0.05)
showFib             = input.bool(true, "Show fib lines")
showExtraFib        = input.bool(true, "Show 0.3 / 0.7 fib lines")
deleteOnMitigation  = input.bool(true, "Delete zone on mitigation")
showSignals         = input.bool(true, "Show sweep + MSS entry labels")
signalSweepLookback = input.int(5, "Signal sweep lookback", minval=2)
showDebug           = input.bool(false, "Show debug labels / values")

// ==================================================
// Helper functions (return values only, no global mutation)
// ==================================================
f_find_low_source(_pivotOffset, _scanBars) =>
    float bestClose = na
    int bestOffset = na
    for i = 1 to _scanBars
        int off = _pivotOffset + i
        bool hasHistory = off <= bar_index
        if hasHistory and close[off] < open[off]
            float c = close[off]
            if na(bestClose) or c < bestClose or (c == bestClose and off < bestOffset)
                bestClose := c
                bestOffset := off
    bool found = not na(bestOffset)
    int sourceBar = found ? bar_index - bestOffset : na
    float sourceHigh = found ? high[bestOffset] : na
    float sourceLow = found ? low[bestOffset] : na
    [found, sourceBar, sourceHigh, sourceLow]

f_find_high_source(_pivotOffset, _scanBars) =>
    float bestClose = na
    int bestOffset = na
    for i = 1 to _scanBars
        int off = _pivotOffset + i
        bool hasHistory = off <= bar_index
        if hasHistory and close[off] > open[off]
            float c = close[off]
            if na(bestClose) or c > bestClose or (c == bestClose and off < bestOffset)
                bestClose := c
                bestOffset := off
    bool found = not na(bestOffset)
    int sourceBar = found ? bar_index - bestOffset : na
    float sourceHigh = found ? high[bestOffset] : na
    float sourceLow = found ? low[bestOffset] : na
    [found, sourceBar, sourceHigh, sourceLow]

f_has_source(_sourceBars, _sourceBar) =>
    bool exists = false
    if array.size(_sourceBars) > 0
        for i = 0 to array.size(_sourceBars) - 1
            if array.get(_sourceBars, i) == _sourceBar
                exists := true
    exists

f_zone_exists(_zoneSourceBars, _zoneDirs, _sourceBar, _dir) =>
    bool exists = false
    if array.size(_zoneSourceBars) > 0
        for i = 0 to array.size(_zoneSourceBars) - 1
            if array.get(_zoneSourceBars, i) == _sourceBar and array.get(_zoneDirs, i) == _dir
                exists := true
    exists

// ==================================================
// PART 1 — HTF external bias engine
// ==================================================
htfPivotHigh = request.security(syminfo.tickerid, htfTf, ta.pivothigh(high, htfSwingLen, htfSwingLen))
htfPivotLow = request.security(syminfo.tickerid, htfTf, ta.pivotlow(low, htfSwingLen, htfSwingLen))
htfClose = request.security(syminfo.tickerid, htfTf, close)

var float lastHtfSwingHigh = na
var float lastHtfSwingLow = na
if not na(htfPivotHigh)
    lastHtfSwingHigh := htfPivotHigh
if not na(htfPivotLow)
    lastHtfSwingLow := htfPivotLow

var int externalBias = 0 // 1 bullish, -1 bearish, 0 unknown
if not na(lastHtfSwingHigh) and htfClose > lastHtfSwingHigh
    externalBias := 1
else if not na(lastHtfSwingLow) and htfClose < lastHtfSwingLow
    externalBias := -1

// ==================================================
// PART 2 — Internal structure shift / expansion state
// ==================================================
var int expansionDir = 0 // 1 bullish expansion, -1 bearish expansion, 0 inactive
var int prevExternalBias = 0
if externalBias != prevExternalBias
    expansionDir := 0
prevExternalBias := externalBias

bullInternalShift = externalBias == 1 and close > ta.highest(high[1], internalShiftLookbk)
bearInternalShift = externalBias == -1 and close < ta.lowest(low[1], internalShiftLookbk)
if bullInternalShift
    expansionDir := 1
if bearInternalShift
    expansionDir := -1

// ==================================================
// PART 7 — Zone / candidate storage
// ==================================================
var pendingLowSourceBar = array.new_int()
var pendingLowSourceHigh = array.new_float()
var pendingLowSourceLow = array.new_float()
var pendingLowPivotBar = array.new_int()

var pendingHighSourceBar = array.new_int()
var pendingHighSourceHigh = array.new_float()
var pendingHighSourceLow = array.new_float()
var pendingHighPivotBar = array.new_int()

var zoneBoxes = array.new_box()
var zoneMidLines = array.new_line()
var zoneFib03Lines = array.new_line()
var zoneFib07Lines = array.new_line()
var zoneTop = array.new_float()
var zoneBot = array.new_float()
var zoneMid = array.new_float()
var zoneDir = array.new_int()
var zoneStartBar = array.new_int()
var zoneSourceBar = array.new_int()
var zoneActive = array.new_bool()
var zoneEntryState = array.new_int()     // 0 waiting sweep, 1 waiting MSS, 2 done
var zoneEntryTrigger = array.new_float() // bullish: sweep-bar high, bearish: sweep-bar low

// ==================================================
// PART 3 — Local swing detection + left-scan candidate build
// ==================================================
swingLow = ta.pivotlow(low, localPivotLen, localPivotLen)
swingHigh = ta.pivothigh(high, localPivotLen, localPivotLen)

if not na(swingLow)
    pivotOffset = localPivotLen
    [foundLowSrc, lowSrcBar, lowSrcHigh, lowSrcLow] = f_find_low_source(pivotOffset, leftScanBars)
    if foundLowSrc and not f_has_source(pendingLowSourceBar, lowSrcBar)
        array.push(pendingLowSourceBar, lowSrcBar)
        array.push(pendingLowSourceHigh, lowSrcHigh)
        array.push(pendingLowSourceLow, lowSrcLow)
        array.push(pendingLowPivotBar, bar_index - localPivotLen)
        if showDebug
            label.new(lowSrcBar, lowSrcLow, "Low source", xloc=xloc.bar_index, style=label.style_label_up, textcolor=color.white, color=color.new(color.teal, 45))

if not na(swingHigh)
    pivotOffset = localPivotLen
    [foundHighSrc, highSrcBar, highSrcHigh, highSrcLow] = f_find_high_source(pivotOffset, leftScanBars)
    if foundHighSrc and not f_has_source(pendingHighSourceBar, highSrcBar)
        array.push(pendingHighSourceBar, highSrcBar)
        array.push(pendingHighSourceHigh, highSrcHigh)
        array.push(pendingHighSourceLow, highSrcLow)
        array.push(pendingHighPivotBar, bar_index - localPivotLen)
        if showDebug
            label.new(highSrcBar, highSrcHigh, "High source", xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 45))

// ==================================================
// PART 4 + PART 5 + PART 6 — Confirm valid low/high and create expansion-only zones
// ==================================================
validLowConfirmedThisBar = false
validHighConfirmedThisBar = false
validLowSourceBarNow = na
validHighSourceBarNow = na

if array.size(pendingLowSourceBar) > 0
    for i = array.size(pendingLowSourceBar) - 1 to 0 by -1
        srcBar = array.get(pendingLowSourceBar, i)
        srcHigh = array.get(pendingLowSourceHigh, i)
        srcLow = array.get(pendingLowSourceLow, i)
        pivBar = array.get(pendingLowPivotBar, i)

        // Valid low confirms when price closes above source bearish candle high.
        if bar_index > pivBar and close > srcHigh
            validLowConfirmedThisBar := true
            validLowSourceBarNow := srcBar

            canCreateBullZone = externalBias == 1 and expansionDir == 1 and not f_zone_exists(zoneSourceBar, zoneDir, srcBar, 1)
            if canCreateBullZone
                zTop = srcHigh
                zBot = srcLow
                zMid = zBot + (zTop - zBot) * fibLevel

                bullBox = box.new(left=bar_index, top=zTop, right=bar_index + zoneExtendBars, bottom=zBot, xloc=xloc.bar_index, bgcolor=color.new(color.teal, 82), border_color=color.new(color.teal, 35))
                midLine = na
                fib03 = na
                fib07 = na
                if showFib
                    midLine := line.new(x1=bar_index, y1=zMid, x2=bar_index + zoneExtendBars, y2=zMid, xloc=xloc.bar_index, style=line.style_dashed, color=color.new(color.teal, 0))
                    if showExtraFib
                        lv03 = zBot + (zTop - zBot) * 0.3
                        lv07 = zBot + (zTop - zBot) * 0.7
                        fib03 := line.new(x1=bar_index, y1=lv03, x2=bar_index + zoneExtendBars, y2=lv03, xloc=xloc.bar_index, style=line.style_dashed, color=color.new(color.teal, 40))
                        fib07 := line.new(x1=bar_index, y1=lv07, x2=bar_index + zoneExtendBars, y2=lv07, xloc=xloc.bar_index, style=line.style_dashed, color=color.new(color.teal, 40))

                array.push(zoneBoxes, bullBox)
                array.push(zoneMidLines, midLine)
                array.push(zoneFib03Lines, fib03)
                array.push(zoneFib07Lines, fib07)
                array.push(zoneTop, zTop)
                array.push(zoneBot, zBot)
                array.push(zoneMid, zMid)
                array.push(zoneDir, 1)
                array.push(zoneStartBar, bar_index)
                array.push(zoneSourceBar, srcBar)
                array.push(zoneActive, true)
                array.push(zoneEntryState, 0)
                array.push(zoneEntryTrigger, na)

                if showDebug
                    label.new(bar_index, zTop, "Valid Low confirmed\nBull zone\nSrc bar: " + str.tostring(srcBar), style=label.style_label_up, color=color.new(color.teal, 15), textcolor=color.white)
            else if showDebug
                label.new(bar_index, srcHigh, "Valid Low confirmed\n(no zone: filter not aligned)", style=label.style_label_up, color=color.new(color.gray, 55), textcolor=color.white)

            array.remove(pendingLowSourceBar, i)
            array.remove(pendingLowSourceHigh, i)
            array.remove(pendingLowSourceLow, i)
            array.remove(pendingLowPivotBar, i)

if array.size(pendingHighSourceBar) > 0
    for i = array.size(pendingHighSourceBar) - 1 to 0 by -1
        srcBar = array.get(pendingHighSourceBar, i)
        srcHigh = array.get(pendingHighSourceHigh, i)
        srcLow = array.get(pendingHighSourceLow, i)
        pivBar = array.get(pendingHighPivotBar, i)

        // Valid high confirms when price closes below source bullish candle low.
        if bar_index > pivBar and close < srcLow
            validHighConfirmedThisBar := true
            validHighSourceBarNow := srcBar

            canCreateBearZone = externalBias == -1 and expansionDir == -1 and not f_zone_exists(zoneSourceBar, zoneDir, srcBar, -1)
            if canCreateBearZone
                zTop = srcHigh
                zBot = srcLow
                zMid = zBot + (zTop - zBot) * fibLevel

                bearBox = box.new(left=bar_index, top=zTop, right=bar_index + zoneExtendBars, bottom=zBot, xloc=xloc.bar_index, bgcolor=color.new(color.red, 82), border_color=color.new(color.red, 35))
                midLine = na
                fib03 = na
                fib07 = na
                if showFib
                    midLine := line.new(x1=bar_index, y1=zMid, x2=bar_index + zoneExtendBars, y2=zMid, xloc=xloc.bar_index, style=line.style_dashed, color=color.new(color.red, 0))
                    if showExtraFib
                        lv03 = zBot + (zTop - zBot) * 0.3
                        lv07 = zBot + (zTop - zBot) * 0.7
                        fib03 := line.new(x1=bar_index, y1=lv03, x2=bar_index + zoneExtendBars, y2=lv03, xloc=xloc.bar_index, style=line.style_dashed, color=color.new(color.red, 40))
                        fib07 := line.new(x1=bar_index, y1=lv07, x2=bar_index + zoneExtendBars, y2=lv07, xloc=xloc.bar_index, style=line.style_dashed, color=color.new(color.red, 40))

                array.push(zoneBoxes, bearBox)
                array.push(zoneMidLines, midLine)
                array.push(zoneFib03Lines, fib03)
                array.push(zoneFib07Lines, fib07)
                array.push(zoneTop, zTop)
                array.push(zoneBot, zBot)
                array.push(zoneMid, zMid)
                array.push(zoneDir, -1)
                array.push(zoneStartBar, bar_index)
                array.push(zoneSourceBar, srcBar)
                array.push(zoneActive, true)
                array.push(zoneEntryState, 0)
                array.push(zoneEntryTrigger, na)

                if showDebug
                    label.new(bar_index, zBot, "Valid High confirmed\nBear zone\nSrc bar: " + str.tostring(srcBar), style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white)
            else if showDebug
                label.new(bar_index, srcLow, "Valid High confirmed\n(no zone: filter not aligned)", style=label.style_label_down, color=color.new(color.gray, 55), textcolor=color.white)

            array.remove(pendingHighSourceBar, i)
            array.remove(pendingHighSourceHigh, i)
            array.remove(pendingHighSourceLow, i)
            array.remove(pendingHighPivotBar, i)

// ==================================================
// PART 5 + PART 7 + PART 8 — Active zone management, mitigation, optional entries
// ==================================================
if array.size(zoneDir) > 0
    for i = 0 to array.size(zoneDir) - 1
        isActive = array.get(zoneActive, i)
        if isActive
            dir = array.get(zoneDir, i)
            startBar = array.get(zoneStartBar, i)
            srcBar = array.get(zoneSourceBar, i)
            zTop = array.get(zoneTop, i)
            zBot = array.get(zoneBot, i)
            zMid = array.get(zoneMid, i)
            zEndBar = startBar + zoneExtendBars

            // Time expiry based on zone extension window.
            if bar_index > zEndBar
                array.set(zoneActive, i, false)
            else
                // Optional sweep + MSS signal logic.
                if showSignals
                    state = array.get(zoneEntryState, i)
                    zoneTouched = low <= zTop and high >= zBot
                    if dir == 1
                        sweepLow = low < ta.lowest(low[1], signalSweepLookback)
                        closeBackUp = close > open
                        if state == 0 and zoneTouched and sweepLow and closeBackUp
                            array.set(zoneEntryState, i, 1)
                            array.set(zoneEntryTrigger, i, high)
                        else if state == 1
                            trigger = array.get(zoneEntryTrigger, i)
                            if close > trigger
                                label.new(bar_index, low, "BUY\nZone src: " + str.tostring(srcBar), style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white)
                                array.set(zoneEntryState, i, 2)
                    else
                        sweepHigh = high > ta.highest(high[1], signalSweepLookback)
                        closeBackDown = close < open
                        if state == 0 and zoneTouched and sweepHigh and closeBackDown
                            array.set(zoneEntryState, i, 1)
                            array.set(zoneEntryTrigger, i, low)
                        else if state == 1
                            trigger = array.get(zoneEntryTrigger, i)
                            if close < trigger
                                label.new(bar_index, high, "SELL\nZone src: " + str.tostring(srcBar), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)
                                array.set(zoneEntryState, i, 2)

                // Mitigation check only after creation bar.
                if bar_index > startBar
                    mitigated = (dir == 1 and low <= zMid) or (dir == -1 and high >= zMid)
                    if mitigated
                        array.set(zoneActive, i, false)
                        if showDebug
                            label.new(bar_index, zMid, "Zone mitigated\nSrc bar: " + str.tostring(srcBar), style=label.style_label_left, color=color.new(color.yellow, 15), textcolor=color.black)

                        bx = array.get(zoneBoxes, i)
                        midLn = array.get(zoneMidLines, i)
                        f03 = array.get(zoneFib03Lines, i)
                        f07 = array.get(zoneFib07Lines, i)
                        if deleteOnMitigation
                            if not na(bx)
                                box.delete(bx)
                            if not na(midLn)
                                line.delete(midLn)
                            if not na(f03)
                                line.delete(f03)
                            if not na(f07)
                                line.delete(f07)
                        else
                            if not na(bx)
                                faded = dir == 1 ? color.new(color.teal, 92) : color.new(color.red, 92)
                                border = dir == 1 ? color.new(color.teal, 75) : color.new(color.red, 75)
                                box.set_bgcolor(bx, faded)
                                box.set_border_color(bx, border)

// ==================================================
// PART 13 — Debug output
// ==================================================
plot(showDebug ? externalBias : na, "Debug HTF bias (1 / -1 / 0)", color=color.new(color.blue, 0), display=display.data_window)
plot(showDebug ? expansionDir : na, "Debug expansionDir (1 / -1 / 0)", color=color.new(color.orange, 0), display=display.data_window)

if showDebug and bullInternalShift
    label.new(bar_index, high, "Internal bullish shift", style=label.style_label_down, color=color.new(color.green, 25), textcolor=color.white)
if showDebug and bearInternalShift
    label.new(bar_index, low, "Internal bearish shift", style=label.style_label_up, color=color.new(color.maroon, 25), textcolor=color.white)

if showDebug and validLowConfirmedThisBar
    label.new(bar_index, low, "Valid LOW confirmed\nsource bar: " + str.tostring(validLowSourceBarNow), style=label.style_label_up, color=color.new(color.teal, 45), textcolor=color.white)
if showDebug and validHighConfirmedThisBar
    label.new(bar_index, high, "Valid HIGH confirmed\nsource bar: " + str.tostring(validHighSourceBarNow), style=label.style_label_down, color=color.new(color.red, 45), textcolor=color.white)
