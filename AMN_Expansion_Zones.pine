//@version=5
indicator("AMN Expansion Zones v2", shorttitle="AMN Expansion Zones", overlay=true, max_boxes_count=300, max_lines_count=700, max_labels_count=700)

//==================================================
// Inputs
//==================================================
groupHTF = "1) Higher Timeframe Bias"
htfTf = input.timeframe("240", "HTF Timeframe", group=groupHTF)
htfSwingLen = input.int(3, "HTF Swing Length", minval=1, group=groupHTF)

groupStructure = "2) Internal + Swing Structure"
localPivotLen = input.int(3, "Local Pivot Length", minval=1, group=groupStructure)
leftScanBars = input.int(40, "Left Scan Bars", minval=5, maxval=300, group=groupStructure)
internalShiftLookback = input.int(12, "Internal Shift Lookback", minval=2, group=groupStructure)

groupZones = "3) Zone Construction / Lifecycle"
zoneExtendBars = input.int(120, "Zone Extend Bars", minval=5, maxval=500, group=groupZones)
fibLevel = input.float(0.5, "Mitigation Fib Level", minval=0.0, maxval=1.0, step=0.05, group=groupZones)
showFib = input.bool(true, "Show Fib Lines", group=groupZones)
showExtraFib = input.bool(true, "Show 0.3 / 0.7 Lines", group=groupZones)
deleteOnMitigation = input.bool(true, "Delete Zone On Mitigation", group=groupZones)
minZoneSizeTicks = input.int(0, "Min Zone Size (ticks, 0=off)", minval=0, group=groupZones)

groupSignals = "4) Optional Entry Confirmation"
showSignals = input.bool(false, "Show Sweep + MSS Signals", group=groupSignals)
signalMssLookback = input.int(3, "MSS Lookback", minval=2, maxval=20, group=groupSignals)
strictStateEntry = input.bool(true, "Require 1-6 State Sequence", group=groupSignals)

groupVisual = "5) Visual / Debug"
showNumbering = input.bool(false, "Show 1-6 Labels", group=groupVisual)
showDebug = input.bool(false, "Show Debug Plots / Labels", group=groupVisual)

//==================================================
// Helper functions (no global mutation)
//==================================================
f_findBearishSource(int anchorOffset, int maxScan) =>
    float bestClose = na
    float srcTop = na
    float srcBot = na
    int srcBar = na
    for step = 1 to maxScan
        int off = anchorOffset + step
        if bar_index >= off
            bool isBear = close[off] < open[off]
            if isBear
                float c = close[off]
                if na(bestClose) or c < bestClose
                    bestClose := c
                    srcTop := high[off]
                    srcBot := low[off]
                    srcBar := bar_index - off
    [srcBar, srcTop, srcBot]

f_findBullishSource(int anchorOffset, int maxScan) =>
    float bestClose = na
    float srcTop = na
    float srcBot = na
    int srcBar = na
    for step = 1 to maxScan
        int off = anchorOffset + step
        if bar_index >= off
            bool isBull = close[off] > open[off]
            if isBull
                float c = close[off]
                if na(bestClose) or c > bestClose
                    bestClose := c
                    srcTop := high[off]
                    srcBot := low[off]
                    srcBar := bar_index - off
    [srcBar, srcTop, srcBot]

f_containsInt(array<int> arr, int value) =>
    bool found = false
    int n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            if array.get(arr, i) == value
                found := true
    found

f_zoneExists(array<int> sourceBars, array<int> dirs, int sourceBar, int dir) =>
    bool found = false
    int n = array.size(sourceBars)
    if n > 0
        for i = 0 to n - 1
            if array.get(sourceBars, i) == sourceBar and array.get(dirs, i) == dir
                found := true
    found

//==================================================
// Persistent state
//==================================================
var float htfLastSwingHigh = na
var float htfLastSwingLow = na
var int externalBias = 0 // 1 bullish, -1 bearish, 0 neutral
var int expansionDir = 0 // 1 bullish expansion, -1 bearish expansion, 0 none

// Most recent confirmed valid points (for numbering context)
var int lastValidLowBar = na
var float lastValidLowPrice = na
var int lastValidHighBar = na
var float lastValidHighPrice = na

// Pending valid-low candidates
var int[] pendingLowSourceBars = array.new_int()
var float[] pendingLowTops = array.new_float()
var float[] pendingLowBots = array.new_float()
var int[] pendingLowSwingBars = array.new_int()

// Pending valid-high candidates
var int[] pendingHighSourceBars = array.new_int()
var float[] pendingHighTops = array.new_float()
var float[] pendingHighBots = array.new_float()
var int[] pendingHighSwingBars = array.new_int()

// Zone arrays
var box[] zoneBoxes = array.new_box()
var line[] zoneFibMainLines = array.new_line()
var line[] zoneFibLowLines = array.new_line()
var line[] zoneFibHighLines = array.new_line()
var float[] zoneTops = array.new_float()
var float[] zoneBots = array.new_float()
var float[] zoneMids = array.new_float()
var int[] zoneDirs = array.new_int()
var int[] zoneStartBars = array.new_int()
var int[] zoneSourceBars = array.new_int()
var bool[] zoneActive = array.new_bool()

// A+ state machine arrays (1-6 mapping)
// step values:
// 2 = valid source zone formed
// 3 = breakout of zone in expansion direction
// 4 = tap-back rejection pivot formed
// 5 = new LL/HH formed
// 6 = sweep of 4 + MSS confirmation
var int[] zoneStep = array.new_int()
var float[] zoneBreakRef = array.new_float()
var float[] zoneStep4Level = array.new_float()
var int[] zoneStep4Bar = array.new_int()
var bool[] zoneSignalDone = array.new_bool()

// Debug event flags
bool dbgValidLowConfirmed = false
bool dbgValidHighConfirmed = false
bool dbgZoneMitigated = false
bool dbgBullInternalShift = false
bool dbgBearInternalShift = false
int dbgSourceBar = na
int dbgMitigatedDir = 0
int dbgStateEvent = 0

//==================================================
// STEP 1: HTF bias engine
//==================================================
float htfClose = request.security(syminfo.tickerid, htfTf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htfPivotHigh = request.security(syminfo.tickerid, htfTf, ta.pivothigh(high, htfSwingLen, htfSwingLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htfPivotLow = request.security(syminfo.tickerid, htfTf, ta.pivotlow(low, htfSwingLen, htfSwingLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

if not na(htfPivotHigh)
    htfLastSwingHigh := htfPivotHigh
if not na(htfPivotLow)
    htfLastSwingLow := htfPivotLow

if not na(htfLastSwingHigh) and htfClose > htfLastSwingHigh
    externalBias := 1
else if not na(htfLastSwingLow) and htfClose < htfLastSwingLow
    externalBias := -1
// else keep previous bias

//==================================================
// STEP 2: Local swing detection
//==================================================
float swingLow = ta.pivotlow(low, localPivotLen, localPivotLen)
float swingHigh = ta.pivothigh(high, localPivotLen, localPivotLen)

//==================================================
// STEP 3: Valid low / high left-scan candidate sourcing
//==================================================
if not na(swingLow)
    int swingBar = bar_index - localPivotLen
    [srcBarL, srcTopL, srcBotL] = f_findBearishSource(localPivotLen, leftScanBars)
    srcBarL := int(srcBarL)
    bool canQueueLow = not na(srcBarL) and srcBarL < swingBar and not f_containsInt(pendingLowSourceBars, srcBarL)
    if canQueueLow
        array.push(pendingLowSourceBars, srcBarL)
        array.push(pendingLowTops, srcTopL)
        array.push(pendingLowBots, srcBotL)
        array.push(pendingLowSwingBars, swingBar)
        if showDebug
            label.new(srcBarL, srcBotL, "Low source\nbar " + str.tostring(srcBarL), xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)

if not na(swingHigh)
    int swingBar = bar_index - localPivotLen
    [srcBarH, srcTopH, srcBotH] = f_findBullishSource(localPivotLen, leftScanBars)
    srcBarH := int(srcBarH)
    bool canQueueHigh = not na(srcBarH) and srcBarH < swingBar and not f_containsInt(pendingHighSourceBars, srcBarH)
    if canQueueHigh
        array.push(pendingHighSourceBars, srcBarH)
        array.push(pendingHighTops, srcTopH)
        array.push(pendingHighBots, srcBotH)
        array.push(pendingHighSwingBars, swingBar)
        if showDebug
            label.new(srcBarH, srcTopH, "High source\nbar " + str.tostring(srcBarH), xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

//==================================================
// STEP 4: Internal shift / expansion direction
//==================================================
float recentInternalHigh = ta.highest(high[1], internalShiftLookback)
float recentInternalLow = ta.lowest(low[1], internalShiftLookback)

if externalBias != externalBias[1] and externalBias != 0
    expansionDir := 0

bool bullShift = externalBias == 1 and not na(recentInternalHigh) and close > recentInternalHigh
bool bearShift = externalBias == -1 and not na(recentInternalLow) and close < recentInternalLow

if bullShift
    expansionDir := 1
if bearShift
    expansionDir := -1

dbgBullInternalShift := bullShift
dbgBearInternalShift := bearShift

//==================================================
// STEP 5: Valid confirmation + expansion-only zone creation
//==================================================
int pendingLowCount = array.size(pendingLowSourceBars)
if pendingLowCount > 0
    for rev = 0 to pendingLowCount - 1
        int i = pendingLowCount - 1 - rev
        float srcTop = array.get(pendingLowTops, i)
        float srcBot = array.get(pendingLowBots, i)
        int srcBar = array.get(pendingLowSourceBars, i)
        if close > srcTop
            dbgValidLowConfirmed := true
            dbgSourceBar := srcBar
            lastValidLowBar := srcBar
            lastValidLowPrice := srcBot

            bool canCreateBullZone = externalBias == 1 and expansionDir == 1
            bool duplicateZone = f_zoneExists(zoneSourceBars, zoneDirs, srcBar, 1)
            float sizeTicks = (srcTop - srcBot) / syminfo.mintick
            bool bigEnough = minZoneSizeTicks == 0 or sizeTicks >= minZoneSizeTicks
            if canCreateBullZone and not duplicateZone and bigEnough
                int leftX = bar_index
                int rightX = bar_index + zoneExtendBars
                float zoneTop = srcTop
                float zoneBot = srcBot
                float zoneMid = zoneBot + (zoneTop - zoneBot) * fibLevel
                float zone30 = zoneBot + (zoneTop - zoneBot) * 0.3
                float zone70 = zoneBot + (zoneTop - zoneBot) * 0.7

                box zBox = box.new(left=leftX, top=zoneTop, right=rightX, bottom=zoneBot, xloc=xloc.bar_index, border_color=color.new(color.teal, 0), bgcolor=color.new(color.teal, 82))
                line fibMain = na
                line fibLow = na
                line fibHigh = na

                if showFib
                    fibMain := line.new(leftX, zoneMid, rightX, zoneMid, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.teal, 0), style=line.style_dashed, width=1)
                    if showExtraFib
                        fibLow := line.new(leftX, zone30, rightX, zone30, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.teal, 35), style=line.style_dashed, width=1)
                        fibHigh := line.new(leftX, zone70, rightX, zone70, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.teal, 35), style=line.style_dashed, width=1)

                array.push(zoneBoxes, zBox)
                array.push(zoneFibMainLines, fibMain)
                array.push(zoneFibLowLines, fibLow)
                array.push(zoneFibHighLines, fibHigh)
                array.push(zoneTops, zoneTop)
                array.push(zoneBots, zoneBot)
                array.push(zoneMids, zoneMid)
                array.push(zoneDirs, 1)
                array.push(zoneStartBars, bar_index)
                array.push(zoneSourceBars, srcBar)
                array.push(zoneActive, true)
                array.push(zoneStep, 2)
                array.push(zoneBreakRef, zoneTop)
                array.push(zoneStep4Level, na)
                array.push(zoneStep4Bar, na)
                array.push(zoneSignalDone, false)

                if showNumbering
                    if not na(lastValidHighBar)
                        label.new(lastValidHighBar, lastValidHighPrice, "1", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.blue, 30), textcolor=color.white, size=size.tiny)
                    label.new(srcBar, srcBot, "2", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)

            array.remove(pendingLowSourceBars, i)
            array.remove(pendingLowTops, i)
            array.remove(pendingLowBots, i)
            array.remove(pendingLowSwingBars, i)

int pendingHighCount = array.size(pendingHighSourceBars)
if pendingHighCount > 0
    for rev = 0 to pendingHighCount - 1
        int i = pendingHighCount - 1 - rev
        float srcTop = array.get(pendingHighTops, i)
        float srcBot = array.get(pendingHighBots, i)
        int srcBar = array.get(pendingHighSourceBars, i)
        if close < srcBot
            dbgValidHighConfirmed := true
            dbgSourceBar := srcBar
            lastValidHighBar := srcBar
            lastValidHighPrice := srcTop

            bool canCreateBearZone = externalBias == -1 and expansionDir == -1
            bool duplicateZone = f_zoneExists(zoneSourceBars, zoneDirs, srcBar, -1)
            float sizeTicks = (srcTop - srcBot) / syminfo.mintick
            bool bigEnough = minZoneSizeTicks == 0 or sizeTicks >= minZoneSizeTicks
            if canCreateBearZone and not duplicateZone and bigEnough
                int leftX = bar_index
                int rightX = bar_index + zoneExtendBars
                float zoneTop = srcTop
                float zoneBot = srcBot
                float zoneMid = zoneBot + (zoneTop - zoneBot) * fibLevel
                float zone30 = zoneBot + (zoneTop - zoneBot) * 0.3
                float zone70 = zoneBot + (zoneTop - zoneBot) * 0.7

                box zBox = box.new(left=leftX, top=zoneTop, right=rightX, bottom=zoneBot, xloc=xloc.bar_index, border_color=color.new(color.red, 0), bgcolor=color.new(color.red, 84))
                line fibMain = na
                line fibLow = na
                line fibHigh = na

                if showFib
                    fibMain := line.new(leftX, zoneMid, rightX, zoneMid, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 0), style=line.style_dashed, width=1)
                    if showExtraFib
                        fibLow := line.new(leftX, zone30, rightX, zone30, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 35), style=line.style_dashed, width=1)
                        fibHigh := line.new(leftX, zone70, rightX, zone70, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 35), style=line.style_dashed, width=1)

                array.push(zoneBoxes, zBox)
                array.push(zoneFibMainLines, fibMain)
                array.push(zoneFibLowLines, fibLow)
                array.push(zoneFibHighLines, fibHigh)
                array.push(zoneTops, zoneTop)
                array.push(zoneBots, zoneBot)
                array.push(zoneMids, zoneMid)
                array.push(zoneDirs, -1)
                array.push(zoneStartBars, bar_index)
                array.push(zoneSourceBars, srcBar)
                array.push(zoneActive, true)
                array.push(zoneStep, 2)
                array.push(zoneBreakRef, zoneBot)
                array.push(zoneStep4Level, na)
                array.push(zoneStep4Bar, na)
                array.push(zoneSignalDone, false)

                if showNumbering
                    if not na(lastValidLowBar)
                        label.new(lastValidLowBar, lastValidLowPrice, "1", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.blue, 30), textcolor=color.white, size=size.tiny)
                    label.new(srcBar, srcTop, "2", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)

            array.remove(pendingHighSourceBars, i)
            array.remove(pendingHighTops, i)
            array.remove(pendingHighBots, i)
            array.remove(pendingHighSwingBars, i)

//==================================================
// STEP 6 + STEP 7 + STEP 8:
// Multi-zone lifecycle, mitigation, and A+ 1-6 state progression.
//==================================================
int zoneCount = array.size(zoneBoxes)
if zoneCount > 0
    for i = 0 to zoneCount - 1
        bool isActive = array.get(zoneActive, i)
        if isActive
            int dir = array.get(zoneDirs, i)
            int startBar = array.get(zoneStartBars, i)
            int endBar = startBar + zoneExtendBars
            float top = array.get(zoneTops, i)
            float bot = array.get(zoneBots, i)
            float mid = array.get(zoneMids, i)
            int step = array.get(zoneStep, i)
            float breakRef = array.get(zoneBreakRef, i)
            float step4Level = array.get(zoneStep4Level, i)
            bool sigDone = array.get(zoneSignalDone, i)

            bool expired = bar_index > endBar
            bool mitigated = false
            if bar_index > startBar
                if dir == 1 and low <= mid
                    mitigated := true
                if dir == -1 and high >= mid
                    mitigated := true

            // State 3: breakout of zone in expansion direction.
            if bar_index > startBar and step == 2
                bool broke = dir == 1 ? close > top : close < bot
                if broke
                    step := 3
                    breakRef := dir == 1 ? high : low
                    dbgStateEvent := 3
                    if showNumbering
                        label.new(bar_index, dir == 1 ? low : high, "3", xloc=xloc.bar_index, style=dir == 1 ? label.style_label_up : label.style_label_down, color=dir == 1 ? color.new(color.teal, 0) : color.new(color.red, 0), textcolor=color.white, size=size.tiny)

            // State 4: tap-back rejection pivot.
            if bar_index > startBar and step == 3
                bool touchedZone = low <= top and high >= bot
                bool reject = dir == 1 ? close > open : close < open
                if touchedZone and reject
                    step := 4
                    step4Level := dir == 1 ? low : high
                    array.set(zoneStep4Bar, i, bar_index)
                    dbgStateEvent := 4
                    if showNumbering
                        label.new(bar_index, step4Level, "4", xloc=xloc.bar_index, style=dir == 1 ? label.style_label_up : label.style_label_down, color=color.new(color.yellow, 10), textcolor=color.black, size=size.tiny)

            // State 5: new LL/HH formed after state 4.
            if bar_index > startBar and step == 4
                bool formedNewExtreme = dir == 1 ? high > breakRef : low < breakRef
                if formedNewExtreme
                    step := 5
                    breakRef := dir == 1 ? high : low
                    dbgStateEvent := 5
                    if showNumbering
                        label.new(bar_index, dir == 1 ? high : low, "5", xloc=xloc.bar_index, style=dir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)

            // State 6: sweep of 4 + MSS confirmation.
            bool stateGate = strictStateEntry ? step == 5 : step >= 4
            if showSignals and stateGate and not sigDone and not na(step4Level)
                bool swept4 = dir == 1 ? low < step4Level : high > step4Level
                bool mss = dir == 1 ? close > ta.highest(high[1], signalMssLookback) : close < ta.lowest(low[1], signalMssLookback)
                if swept4 and mss
                    step := 6
                    array.set(zoneSignalDone, i, true)
                    dbgStateEvent := 6
                    string txt = dir == 1 ? "BUY" : "SELL"
                    if showNumbering
                        txt := "6 " + txt
                    label.new(bar_index, dir == 1 ? low : high, txt, xloc=xloc.bar_index, style=dir == 1 ? label.style_label_up : label.style_label_down, color=dir == 1 ? color.new(color.teal, 0) : color.new(color.red, 0), textcolor=color.white, size=size.small)

            // Save step updates
            array.set(zoneStep, i, step)
            array.set(zoneBreakRef, i, breakRef)
            array.set(zoneStep4Level, i, step4Level)

            // Deactivation on expiry/mitigation.
            if expired or mitigated
                array.set(zoneActive, i, false)
                if mitigated
                    dbgZoneMitigated := true
                    dbgMitigatedDir := dir
                box zBox = array.get(zoneBoxes, i)
                line fibMain = array.get(zoneFibMainLines, i)
                line fibLow = array.get(zoneFibLowLines, i)
                line fibHigh = array.get(zoneFibHighLines, i)
                if mitigated and deleteOnMitigation
                    if not na(zBox)
                        box.delete(zBox)
                        array.set(zoneBoxes, i, na)
                    if not na(fibMain)
                        line.delete(fibMain)
                        array.set(zoneFibMainLines, i, na)
                    if not na(fibLow)
                        line.delete(fibLow)
                        array.set(zoneFibLowLines, i, na)
                    if not na(fibHigh)
                        line.delete(fibHigh)
                        array.set(zoneFibHighLines, i, na)
                else if mitigated and not deleteOnMitigation
                    color fadedBg = dir == 1 ? color.new(color.teal, 92) : color.new(color.red, 92)
                    color fadedBorder = color.new(color.gray, 65)
                    if not na(zBox)
                        box.set_bgcolor(zBox, fadedBg)
                        box.set_border_color(zBox, fadedBorder)
                    if not na(fibMain)
                        line.set_color(fibMain, color.new(color.gray, 55))
                    if not na(fibLow)
                        line.set_color(fibLow, color.new(color.gray, 65))
                    if not na(fibHigh)
                        line.set_color(fibHigh, color.new(color.gray, 65))

//==================================================
// STEP 13: Debug / verification visuals
//==================================================
plot(showDebug ? externalBias : na, title="Debug HTF Bias (1/-1)", color=color.new(color.orange, 0), linewidth=2, style=plot.style_stepline)
plot(showDebug ? expansionDir : na, title="Debug Expansion Dir (1/-1)", color=color.new(color.blue, 0), linewidth=2, style=plot.style_stepline)

plotshape(showDebug and not na(swingLow), title="Debug Swing Low", style=shape.circle, location=location.belowbar, color=color.new(color.teal, 30), size=size.tiny, text="SL")
plotshape(showDebug and not na(swingHigh), title="Debug Swing High", style=shape.circle, location=location.abovebar, color=color.new(color.red, 30), size=size.tiny, text="SH")
plotshape(showDebug and dbgBullInternalShift, title="Debug Bull Internal Shift", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.tiny, text="INT+")
plotshape(showDebug and dbgBearInternalShift, title="Debug Bear Internal Shift", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="INT-")

if showDebug and dbgValidLowConfirmed
    label.new(bar_index, low, "Valid Low confirmed\nsrc " + str.tostring(dbgSourceBar), xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
if showDebug and dbgValidHighConfirmed
    label.new(bar_index, high, "Valid High confirmed\nsrc " + str.tostring(dbgSourceBar), xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
if showDebug and dbgZoneMitigated
    string mtxt = dbgMitigatedDir == 1 ? "Bull zone mitigated" : "Bear zone mitigated"
    label.new(bar_index, close, mtxt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.gray, 35), textcolor=color.white, size=size.tiny)
if showDebug and dbgStateEvent > 0
    label.new(bar_index, close, "State " + str.tostring(dbgStateEvent), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.silver, 20), textcolor=color.black, size=size.tiny)
